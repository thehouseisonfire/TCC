FROM rust:1.93.1-alpine@sha256:4fec02de605563c297c78a31064c8335bc004fa2b0bf406b1b99441da64e2d2d AS builder

RUN apk add --no-cache musl-dev=1.2.5-r21

WORKDIR /app

COPY Cargo.toml Cargo.lock ./
COPY crates/authz-server ./crates/authz-server

# Create minimal workspace config that only includes authz-server
RUN printf '[workspace]\nmembers = ["crates/authz-server"]\nresolver = "2"\n' > Cargo.toml

RUN cargo build --release -p authz-server

FROM alpine:3.23.3@sha256:25109184c71bdad752c8312a8623239686a9a2071e8825f20acb8f2198c3f659

RUN apk add --no-cache ca-certificates=20260413-r0

COPY --from=builder /app/target/release/authz-server /usr/local/bin/authz-server

EXPOSE 8081
CMD ["/usr/local/bin/authz-server"]
