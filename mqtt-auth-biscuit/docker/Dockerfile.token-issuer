FROM rust:1.93.1-alpine@sha256:4fec02de605563c297c78a31064c8335bc004fa2b0bf406b1b99441da64e2d2d AS builder

RUN apk add --no-cache musl-dev=1.2.5-r21

WORKDIR /app

COPY Cargo.toml Cargo.lock ./
COPY crates/mosquitto-plugin ./crates/mosquitto-plugin
COPY crates/authz-server ./crates/authz-server
COPY crates/token-issuer ./crates/token-issuer
RUN printf '[workspace]\nmembers = ["crates/token-issuer"]\nresolver = "2"\n' > Cargo.toml

RUN cargo build --release -p token-issuer

FROM gcr.io/distroless/cc-debian12@sha256:329e54034ce498f9c6b345044e8f530c6691f99e94a92446f68c0adf9baa8464

COPY --from=builder /app/target/release/token-issuer /usr/local/bin/token-issuer

EXPOSE 8082
CMD ["/usr/local/bin/token-issuer"]
