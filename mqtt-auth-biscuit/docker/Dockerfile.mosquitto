# Legacy Dockerfile kept for the official image path.
# Not used for now: until Mosquitto 2.1.3 is officially released, use
# docker/Dockerfile.mosquitto.custom instead.
FROM rust:1.93.1-alpine@sha256:4fec02de605563c297c78a31064c8335bc004fa2b0bf406b1b99441da64e2d2d AS builder

RUN apk add --no-cache build-base=0.5-r3 cmake=4.1.3-r0 perl=5.42.2-r0 musl-dev=1.2.5-r21

WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY crates/mosquitto-plugin ./crates/mosquitto-plugin
COPY crates/token-issuer ./crates/token-issuer
COPY crates/authz-server ./crates/authz-server
RUN printf '[workspace]\nmembers = ["crates/mosquitto-plugin"]\nresolver = "2"\n' > Cargo.toml

RUN RUSTFLAGS="-C target-feature=-crt-static" cargo build --release -p mosquitto-auth-biscuit

# Pin explicit minor/patch instead of floating `:2`
FROM eclipse-mosquitto:2.1.2-alpine@sha256:9cfdd46ad59f3e3e5f592f6baf57ab23e1ad00605509d0f5c1e9b179c5314d87

# Install basic C++ libs required by the dynamically linked Rust plugin
RUN apk add --no-cache libgcc=15.2.0-r2 libstdc++=15.2.0-r2

COPY docker/jwt_public.pem /mosquitto/config/
COPY docker/biscuit_public.key /mosquitto/config/

# No extra libc compatibility should be needed if built for musl
# COPY docker/packages/*.apk /tmp/
# RUN apk add --allow-untrusted /tmp/*.apk && rm /tmp/*.apk

COPY --from=builder /app/target/release/libmosquitto_auth_biscuit.so /mosquitto/plugins/
