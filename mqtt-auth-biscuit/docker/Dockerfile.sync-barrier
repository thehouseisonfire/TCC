FROM rust:1.93.1-alpine@sha256:4fec02de605563c297c78a31064c8335bc004fa2b0bf406b1b99441da64e2d2d AS builder

RUN apk add --no-cache musl-dev=1.2.5-r23

WORKDIR /app

COPY mqtt-auth-biscuit/Cargo.toml mqtt-auth-biscuit/Cargo.lock ./
COPY mqtt-auth-biscuit/crates/benchmarks ./crates/benchmarks
COPY rumqtt /rumqtt
RUN printf '[workspace]\nmembers = ["crates/benchmarks"]\nresolver = "2"\n' > Cargo.toml

RUN cargo build --release -p gen-tokens --bin sync-barrier

FROM alpine:3.23.3@sha256:25109184c71bdad752c8312a8623239686a9a2071e8825f20acb8f2198c3f659

RUN apk add --no-cache ca-certificates=20260611-r0

COPY --from=builder /app/target/release/sync-barrier /usr/local/bin/sync-barrier

EXPOSE 8083
CMD ["/usr/local/bin/sync-barrier"]
