#!/usr/bin/env bash
# Build campaign Docker images once and record their exact identities in
# mqtt-auth-biscuit/docker/image-freeze.json.
#
# The manifest (minus the archive hash) is generated from the final source
# commit and needs no further source commit. Run scripts/save-images next
# to archive the frozen images.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
WORKDIR="$REPO_ROOT/mqtt-auth-biscuit"
COMPOSE_BIN=${DOCKER_COMPOSE_BIN:-"docker compose"}
COMPOSE_FILES=(-f docker/docker-compose.yml -f docker/docker-compose.tls.yml)
MANIFEST="$WORKDIR/docker/image-freeze.json"

# shellcheck disable=SC2086
(cd "$WORKDIR" && $COMPOSE_BIN "${COMPOSE_FILES[@]}" build)

SOURCE_COMMIT="$(git -C "$REPO_ROOT" rev-parse HEAD)"
export SOURCE_COMMIT
python3 - "$WORKDIR" docker/docker-compose.yml docker/docker-compose.tls.yml <<'EOF'
import hashlib
import json
import os
import subprocess
import sys

workdir, *compose_files = sys.argv[1:]
manifest_path = os.path.join(workdir, "docker", "image-freeze.json")

images: set[str] = set()


def compose(*args: str) -> str:
    cmd = os.environ.get("DOCKER_COMPOSE_BIN", "docker compose").split()
    for path in compose_files:
        cmd += ["-f", path]
    out = subprocess.run(
        [*cmd, *args],
        cwd=workdir,
        capture_output=True,
        text=True,
        check=True,
    )
    return out.stdout


profiles = compose("config", "--profiles").split()
profile_args: list[str] = []
for profile in profiles:
    profile_args += ["--profile", profile]

config = json.loads(compose(*profile_args, "config", "--format", "json"))
# Services with `build:` but no `image:` get compose's default name
# <project>-<service>, where the project is the first compose file's
# directory. Every derived reference is verified with `docker image
# inspect` below, so a naming change fails loudly instead of recording
# wrong data.
project = os.path.basename(
    os.path.dirname(os.path.join(workdir, compose_files[0]))
)
image_services: dict[str, list[str]] = {}
for name, service in config.get("services", {}).items():
    image = service.get("image") or f"{project}-{name}"
    image_services.setdefault(image, []).append(name)
images = set(image_services)

services = []
for image in sorted(images):
    try:
        inspect_out = subprocess.run(
            ["docker", "image", "inspect", image],
            capture_output=True,
            text=True,
            check=True,
        )
    except subprocess.CalledProcessError:
        subprocess.run(["docker", "pull", image], check=True)
        inspect_out = subprocess.run(
            ["docker", "image", "inspect", image],
            capture_output=True,
            text=True,
            check=True,
        )
    info = json.loads(inspect_out.stdout)[0]
    services.append(
        {
            "service": sorted(image_services[image])[0],
            "image": image,
            "image_id": info["Id"],
            "repo_digests": sorted(info.get("RepoDigests") or []),
            "platform": info.get("Os", "") + "/" + info.get("Architecture", ""),
        }
    )

manifest = {
    "schema_version": 1,
    "source_commit": os.environ["SOURCE_COMMIT"],
    "compose_files": [
        {
            "path": f"docker/{os.path.basename(path)}",
            "sha256": hashlib.sha256(
                open(os.path.join(workdir, path), "rb").read()
            ).hexdigest(),
        }
        for path in compose_files
    ],
    "services": services,
    "archive": None,
}
with open(manifest_path, "w") as handle:
    json.dump(manifest, handle, indent=2)
    handle.write("\n")
print(f"wrote {manifest_path} ({len(services)} images)")
EOF

echo "manifest: $MANIFEST"
