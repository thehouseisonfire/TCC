FROM rust:1.93-alpine AS builder

RUN apk add --no-cache musl-dev

WORKDIR /app

COPY Cargo.toml Cargo.lock ./
COPY crates/mosquitto-plugin ./crates/mosquitto-plugin
COPY crates/benchmarks ./crates/benchmarks
COPY crates/token-issuer ./crates/token-issuer

RUN cargo build --release -p token-issuer

FROM gcr.io/distroless/cc-debian12

COPY --from=builder /app/target/release/token-issuer /usr/local/bin/token-issuer

EXPOSE 8082
CMD ["/usr/local/bin/token-issuer"]
